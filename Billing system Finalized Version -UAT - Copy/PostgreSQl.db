-- ============================================================
-- STEP 6: VERIFY SETUP
-- ============================================================

SELECT '✅ Database setup complete!' AS status;
SELECT 'Companies: ' || COUNT(*) FROM companies;
SELECT 'Units: ' || COUNT(*) FROM units;
SELECT 'Users: ' || COUNT(*) FROM users;
SELECT 'System Settings: ' || COUNT(*) FROM system_settings;