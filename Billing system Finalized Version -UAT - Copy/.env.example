# ============================================================
# INVOICE MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION (.env)
# ============================================================

# Application Environment ('production' or 'development')
FLASK_CONFIG=development
FLASK_DEBUG=False

# Host & Port binding
HOST=0.0.0.0
PORT=5000

# Secret Key (generate a strong random string for production)
SECRET_KEY=replace-with-a-very-long-random-secret-key-for-production

# Initial Admin Email (Used to seed the first admin user on fresh database)
INITIAL_ADMIN_EMAIL=admin@yourcompany.com

# Database Connection
# Development defaults to SQLite. Set DEV_DATABASE_URL only to override it.
# UAT/production uses DATABASE_URL with a PostgreSQL connection string.
DATABASE_URL=postgresql://invoice_user:your_secure_password@localhost:5432/invoice_db

# Email Configuration (Used for OTP-based login and workflow notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@company.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@company.com

# UAT & Testing Flags
# Set MAIL_SUPPRESS_SEND=True to test without sending real emails (OTP will be printed to server log)
MAIL_SUPPRESS_SEND=False
# Set UAT_MODE=True to allow login via server log OTP even if external SMTP fails
UAT_MODE=True

# Background Scheduler
START_SCHEDULER=True

# Security & Cookies (Set to True if site is served over HTTPS)
PREFERRED_URL_SCHEME=http
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
MAX_CONTENT_LENGTH=16777216

# Branding
APP_NAME=Invoice System
APP_VERSION=2.0.0
